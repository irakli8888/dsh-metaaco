      { "id": "tests", "prompt": "Inspect the supplied patch and propose tests.", "dependsOn": ["patch"], "inputs": [{ "name": "patch", "taskId": "patch" }], "slots": 1, "model": null }
    ]
  },
  "durationEstimatesSeconds": { "review": 30, "patch": 10, "tests": 10 }
